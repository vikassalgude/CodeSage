{
  "name": "codesage-server",
  "version": "1.0.0",
  "description": "CodeSage — Production Codebase RAG Assistant API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "build": "prisma generate",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "start:production": "node src/server.js & node src/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "@prisma/client": "^5.22.0",
    "@qdrant/js-client-rest": "^1.11.0",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.30.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^1.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "langfuse": "^3.33.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "tiktoken": "^1.0.20",
    "tree-sitter": "^0.22.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.5",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
